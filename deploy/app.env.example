# Vorlage fuer /etc/learn/app.env auf dem Server.
#
# Die echte Datei bleibt auf dem Server, kommt nie ins Image und nie ins
# Repository. Rechte 0600, Eigentuemer ist der Systemuser learn.
#
# Diese Vorlage enthaelt bewusst keine Geheimnisse. DB_PASSWORD steht hier
# nicht: Es kommt als Podman-Secret in beide Container, damit Anwendung und
# Datenbank nicht auseinanderlaufen koennen.

APP_NAME=LEARN
APP_ENV=production
APP_DEBUG=false

# Einmalig erzeugen:
#   podman run --rm localhost/lapp:latest php artisan key:generate --show
# Ohne ihn sind Sitzungen und verschluesselte Werte nach dem naechsten Start
# unlesbar.
APP_KEY=

# Muss die echte Adresse samt Schema tragen. Laravel baut daraus die Links im
# CSV-Export der Einladungen. Steht hier localhost, bekommen die Lernenden
# unbrauchbare Links.
APP_URL=http://localhost

# config/app.php faellt ohne diesen Wert auf 'en' zurueck. Die Uebersetzungen
# liegen unter lang/de, die Oberflaeche liefe sonst auf Englisch.
APP_LOCALE=de
APP_FALLBACK_LOCALE=de

# Bindeadresse von Caddy. Der Doppelpunkt ohne Host bindet an jede Adresse,
# der Wert muss also bei einem IP-Wechsel nicht nachgezogen werden. Nur APP_URL
# traegt die konkrete Adresse.
SERVER_NAME=:80

# Geteilter Netzwerk-Namespace des Pods, kein DNS-Name wie bei Compose.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=learn
DB_USERNAME=learn

# Alle drei laufen ueber die Datenbank. Deshalb kein Redis im Pod.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Kein TLS im LAN-Betrieb ohne Domain. Auf true gesetzt wuerde der Browser das
# Sitzungscookie ueber http gar nicht erst speichern, und niemand koennte sich
# anmelden.
SESSION_SECURE_COOKIE=false

# Festgelegt: kein Mailversand. Passwort-Reset-Links landen in
# storage/logs/laravel.log, das dafuer ein eigenes Volume hat. Einladungen
# laufen ueber den CSV-Export im Admin-Bereich.
MAIL_MAILER=log

# Zwei-Faktor und Passkeys sind vorerst aus (config/fortify.php). Passkeys
# verlangen einen vertrauenswuerdigen Secure Context, den es ohne installiertes
# Root-Zertifikat auf den Geraeten nicht gibt. Zum Wiedereinschalten hier auf
# true setzen, der Code und seine Tests sind vollstaendig erhalten.
# FORTIFY_TWO_FACTOR=true
# FORTIFY_PASSKEYS=true

LOG_CHANNEL=stack
LOG_LEVEL=warning
